#!/bin/bash

# Script to convert a Markdown file to PDF using grip and wkhtmltopdf.
#
# Requirements:
#   - grip: to render Markdown to HTML
#   - wkhtmltopdf: to convert HTML to PDF
#
# Usage:
#   ./script_name.sh input.md output.pdf
#
# Arguments:
#   $1: Input Markdown file (.md)
#   $2: Output PDF file (.pdf)
#
# The script:
#   1. Checks if grip and wkhtmltopdf are installed.
#   2. Converts the Markdown file to a temporary HTML file.
#   3. Converts the HTML file to PDF.
#   4. Cleans up the temporary HTML file.
#   5. Prints confirmation of PDF creation.


# Check if required commands are available
command -v wkhtmltopdf >/dev/null 2>&1 || { echo >&2 "wkhtmltopdf is not installed. Aborting."; exit 1; }

# Check for input and output file arguments
# Check for input argument
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "Usage: $0 input.md [output.pdf]"
    exit 1
fi

INPUT_MD="$1"

# If output PDF is not provided, use input filename with .pdf extension
if [ -n "$2" ]; then
    OUTPUT_PDF="$2"
else
    OUTPUT_PDF="${INPUT_MD%.md}.pdf"
fi

TEMP_HTML="temp.html"
TEMP_CSS="temp.css"
TEMP_CSS_empty="temp_empty.css"

touch $TEMP_CSS_empty

# Create a temporary CSS file
cat <<EOT > "$TEMP_CSS"
@page {
    size: A4;
    margin: 5mm 10mm 2mm 10mm;
}
.page-break {
    break-before: page;
}

html, body {
    width: 100%;
    margin: 0;
    padding: 0;
    background: #ffffff;
    color: #24292e;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    text-align: justify;
    line-height: 1.5;
}

/* ===== HEADINGS (GitHub-like) ===== */
h1 {
    font-size: 22px;
    border-bottom: 1px solid #eaecef;
    padding-bottom: 6px;
    margin-top: 18px;
}

h2 {
    font-size: 18px;
    border-bottom: 1px solid #eaecef;
    padding-bottom: 4px;
    margin-top: 14px;
}

h3 {
    font-size: 16px;
    margin-top: 12px;
}

/* ===== LINKS ===== */
a {
    color: #0366d6;
    text-decoration: none;
    white-space: nowrap;
    overflow-wrap: normal;
}

a:hover {
    text-decoration: underline;
}

/* ===== PARAGRAPHS ===== */
p {
    margin: 6px 0;
    text-align: justify;
}

/* ===== CODE ===== */
code {
    background: #f6f8fa;
    padding: 2px 4px;
    border-radius: 3px;
    font-size: 12px;
}

/* ===== TABLES (GitHub style) ===== */
table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    margin: 10px 0;
}

th {
    background: #f6f8fa;
    font-weight: 600;
    border: 1px solid #d0d7de;
    padding: 6px;
}

td {
    border: 1px solid #d0d7de;
    padding: 6px;
    vertical-align: top;
}

/* ===== IMAGES ===== */
img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 10px 0;
}

/* ===== BLOCKS ===== */
div {
    max-width: 100%;
}
EOT

# Convert Markdown to HTML
pandoc "$INPUT_MD" -o "$TEMP_HTML" -s \
    --from markdown \
    -c "$TEMP_CSS_empty"

# Convert HTML to PDF
weasyprint "$TEMP_HTML" "$OUTPUT_PDF" --stylesheet $TEMP_CSS

# Cleanup
rm -f "$TEMP_HTML" "$TEMP_CSS" "$TEMP_CSS_empty"

echo "PDF created: $OUTPUT_PDF"

