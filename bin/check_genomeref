#!/usr/bin/env bash
#
# check_genomeref — check whether interval/position coordinates in an input
# file exceed the contig lengths of one or more genome references.
#
# For each reference (.fai discovered recursively under a directory) and each
# chromosome in the input, reports the input's max coordinate, the contig
# length, and whether the coordinate runs past the contig end. Useful for
# identifying which genome build a coordinate set belongs to.
#
# Inputs supported (auto-detected by extension):
#   *.parquet          Two layouts, auto-detected from the schema (case-insensitive):
#                         VCF-like : CHROM, POS, REF, ALT -> chrom=CHROM, coord=POS
#                         cnvDB    : Chr, Start, End       -> chrom=Chr,   coord=End (1-based inclusive)
#                       -i may also be a directory (e.g. a Hive-partitioned dataset such as
#                       ShortVariantsDB_curated.parquet/CHROM=chr1/part-*.parquet); all
#                       *.parquet files under it are read together as one input.
#   *.bim              PLINK: <chr snp cm pos a1 a2>, no header (point positions)
#   *.bed / *.bed.gz   BED: <chr start end ...>, 0-based half-open
#   *.tsv / *.csv      Delimited WITH header; Chr/Start/End columns (by name)
#   *.vcf / *.gvcf / *.g.vcf (optionally .gz/.bgz)
#                       Default: reads only the header's ##contig=<ID=..,length=..> lines
#                       (stops at the first record, so instant even on huge gVCFs) and
#                       tests declared length == contig length (exact build fingerprint).
#                       If the header has no ##contig lengths (or VCF_SCAN=1), falls back
#                       to scanning records: coord = max(POS, INFO/END) per CHROM,
#                       tested with the usual "exceeds" rule. INFO/END covers gVCF
#                       reference blocks.
#
# Contig matching is naming-agnostic: 'chr1'/'1', and PLINK's 23/24/25/26 for
# X/Y/XY(PAR)/MT are all normalised to a canonical bare form (1..22,X,Y,MT)
# for the join, while the input's original contig name is shown in the output.
#
# Requires: duckdb (>= 0.9). VCF input also uses gzip + awk (coreutils-level).
#
# Usage:
#   check_genomeref -r <reference_dir> -i <input_file> [-t <parquet|bim|bed|tsv|vcf>]
#   On CCDB: check_genomeref -r /lustre09/project/6008022/LAB_WORKSPACE/RAW_DATA/Genetic/Reference_Data/array_chip_manifest/genome_reference/ -i <input_file> [-t <parquet|bim|bed|tsv|vcf>]
#   On SD4H: check_genomeref -r /mnt/chusj-transcriptomic-cephfs-1/LAB_WORKSPACE/RAW_DATA/Genetic/Reference_Data/reference_genome -i <input_file> [-t <parquet|bim|bed|tsv|vcf>]
#
# Options:
#   -r DIR    Directory searched recursively for *.fai index files (required)
#   -i FILE   Input coordinate file, or a directory of *.parquet files (required)
#   -t TYPE   Force input type (parquet|bim|bed|tsv|vcf; 'gvcf' = alias of vcf); default: infer from extension
#   -h        Show this help
#
# Exit codes: 0 ok · 1 usage/IO error · 2 missing dependency
set -euo pipefail

die()  { printf 'Error: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/{/^set -euo/!p}' "$0" | sed 's/^# \{0,1\}//'; }

# ---- parse args -------------------------------------------------------------
REF_DIR="" INPUT="" ITYPE=""
while getopts ":r:i:t:h" opt; do
  case "$opt" in
    r) REF_DIR=$OPTARG ;;
    i) INPUT=$OPTARG ;;
    t) ITYPE=$OPTARG ;;
    h) usage; exit 0 ;;
    :) die "option -$OPTARG requires an argument" ;;
    \?) die "unknown option -$OPTARG (use -h for help)" ;;
  esac
done

# ---- default reference dir from site (used only when -r is omitted) ---------
if [[ -z $REF_DIR ]]; then
  case "${CC_CLUSTER:-$(hostname -s)}" in
    rorqual)
      REF_DIR=/lustre09/project/6008022/LAB_WORKSPACE/RAW_DATA/Genetic/Reference_Data/array_chip_manifest/genome_reference ;;
    chusj-transcriptomic-server-1)
      REF_DIR=/mnt/chusj-transcriptomic-cephfs-1/LAB_WORKSPACE/RAW_DATA/Genetic/Reference_Data/reference_genome ;;
  esac
fi

command -v duckdb >/dev/null 2>&1 || { echo "Error: duckdb not found in PATH" >&2; exit 2; }
[[ -n $REF_DIR ]] || die "reference directory required (-r); use -h for help"
[[ -n $INPUT   ]] || die "input file required (-i); use -h for help"
[[ -d $REF_DIR ]] || die "reference directory not found: $REF_DIR"
INPUT="${INPUT%/}"   # normalise a trailing slash so extension inference (*.parquet) matches

# ---- infer input type -------------------------------------------------------
if [[ -z $ITYPE ]]; then
  case "$INPUT" in
    *.parquet)              ITYPE=parquet ;;
    *.bim)                  ITYPE=bim ;;
    *.bed|*.bed.gz)         ITYPE=bed ;;
    *.tsv|*.tsv.gz|*.csv|*.csv.gz|*.txt) ITYPE=tsv ;;
    *.vcf|*.vcf.gz|*.vcf.bgz|*.gvcf|*.gvcf.gz|*.gvcf.bgz) ITYPE=vcf ;;   # *.g.vcf* matches *.vcf*
    *) die "cannot infer type from '$INPUT'; pass -t parquet|bim|bed|tsv|vcf" ;;
  esac
fi
[[ $ITYPE == gvcf ]] && ITYPE=vcf
case "$ITYPE" in parquet|bim|bed|tsv|vcf) ;; *) die "invalid -t '$ITYPE' (parquet|bim|bed|tsv|vcf)";; esac

if [[ -d $INPUT ]]; then
  [[ $ITYPE == parquet ]] || die "directory input is only supported for parquet datasets (pass -t parquet)"
elif [[ ! -f $INPUT ]]; then
  die "input path not found: $INPUT"
fi

# ---- discover .fai files ----------------------------------------------------
mapfile -d '' FAIS < <(find "$REF_DIR" -type f -name '*.fai' -print0 | sort -z)
[[ ${#FAIS[@]} -gt 0 ]] || die "no .fai files found under $REF_DIR"

# Resolves $INPUT to what read_parquet() should scan: the file itself, or a
# recursive glob when $INPUT is a directory (e.g. a Hive-partitioned dataset
# with CHROM=chrN/part-*.parquet subfolders).
parquet_source() {
  if [[ -d $INPUT ]]; then
    printf '%s/**/*.parquet' "$INPUT"
  else
    printf '%s' "$INPUT"
  fi
}

# Reference label = parent-dir/filename, e.g. GRCh38/....fna.fai -> "GRCh38".
# Falls back to the .fai basename if the parent isn't informative.
ref_label() {
  local f=$1 parent
  parent=$(basename "$(dirname "$f")")
  if [[ $parent == "." || $parent == "/" || -z $parent ]]; then
    basename "$f" .fai
  else
    printf '%s' "$parent"
  fi
}

# ---- SQL fragments ----------------------------------------------------------
# Canonical contig normaliser applied to BOTH sides of the join.
# Strips 'chr' (any case), maps mitochondrial aliases to MT, and maps PLINK's
# numeric sex/organelle codes (23=X 24=Y 25=XY-PAR 26=MT) to letters.
# Emitted as a SQL expression over a column reference passed in.
norm_expr() { # $1 = column expression
  cat <<SQL
upper(
  CASE
    WHEN regexp_replace(CAST($1 AS VARCHAR), '^chr', '', 'i') IN ('M','MT') THEN 'MT'
    WHEN regexp_replace(CAST($1 AS VARCHAR), '^chr', '', 'i') = '23' THEN 'X'
    WHEN regexp_replace(CAST($1 AS VARCHAR), '^chr', '', 'i') = '24' THEN 'Y'
    WHEN regexp_replace(CAST($1 AS VARCHAR), '^chr', '', 'i') = '25' THEN 'X'
    WHEN regexp_replace(CAST($1 AS VARCHAR), '^chr', '', 'i') = '26' THEN 'MT'
    ELSE regexp_replace(CAST($1 AS VARCHAR), '^chr', '', 'i')
  END
)
SQL
}

# ---- VCF / gVCF -------------------------------------------------------------
# Comparison applied between the input coordinate and the .fai length.
# Default "exceeds" (coord > len). VCF header mode switches to exact equality,
# because ##contig length IS a contig length, not a max observed coordinate.
CMP_OP='>' CMP_COL=exceeds CMP_WORD=exceeding
VCF_TMP=""

# awk program shared by both VCF modes; writes "<contig>\t<length_or_maxcoord>".
#   mode=header : parse ##contig lines, exit at the first record (no full read)
#   mode=scan   : max(POS, INFO/END) per CHROM over all records
# ##contig keys may appear in any order (ID, length, assembly, md5, ...).
# printf %.0f avoids mawk printing large integers in %g notation.
VCF_AWK='
BEGIN { FS = "\t" }
mode == "header" && /^##contig=</ {
  s = substr($0, 11); sub(/>[[:space:]]*$/, "", s)
  id = ""; len = ""
  n = split(s, kv, ",")
  for (k = 1; k <= n; k++) {
    if (kv[k] ~ /^ID=/)          id  = substr(kv[k], 4)
    else if (kv[k] ~ /^length=/) len = substr(kv[k], 8)
  }
  if (id != "" && len ~ /^[0-9]+$/) printf "%s\t%s\n", id, len
  next
}
/^#/ { next }
mode == "header" { exit }
{
  e = $2 + 0
  if (match($8, /(^|;)END=[0-9]+/)) {
    v = substr($8, RSTART, RLENGTH); sub(/^;?END=/, "", v)
    if (v + 0 > e) e = v + 0
  }
  if (!($1 in m) || e > m[$1]) m[$1] = e
}
END { if (mode == "scan") for (c in m) printf "%s\t%.0f\n", c, m[c] }
'

# vcf_extract MODE -> fills $VCF_TMP. gzip -cdf transparently handles plain,
# gzip and bgzip input. In header mode awk exits early, so gzip is killed by
# SIGPIPE (status 141): that is expected and accepted, anything else is fatal.
vcf_extract() { # $1 = header|scan
  local -a st
  set +o pipefail
  gzip -cdf -- "$INPUT" | awk -v mode="$1" "$VCF_AWK" > "$VCF_TMP"
  st=("${PIPESTATUS[@]}")
  set -o pipefail
  [[ ${st[1]} -eq 0 ]] || die "VCF: awk failed while parsing $INPUT"
  [[ ${st[0]} -eq 0 || ( $1 == header && ${st[0]} -eq 141 ) ]] \
    || die "VCF: could not decompress/read $INPUT (gzip exit ${st[0]})"
}

# Detects the input's columns/layout ONCE and caches the resulting
# "raw AS (...)" body in the global $RAW_CTE.
#
# IMPORTANT: this must run as a plain function call in the main shell, not
# inside a $(...) command substitution. die() calls `exit`, and `exit` inside
# a command substitution only terminates that subshell — the parent script
# would otherwise sail on with an empty/partial SQL fragment (this is exactly
# what produced the earlier "syntax error at or near ','" instead of a clean
# error message). Running it here, once, up front, makes die() actually abort
# and avoids re-probing the schema for every reference in the main loop.
#
# max_end (aliased "coord" below) is the largest coordinate tested against
# contig length:
#   parquet -> MAX(POS) if VCF-like (CHROM/POS/REF/ALT), else MAX("End") (1-based inclusive)
#   bed     -> MAX(end col) (0-based half-open end == count of bases)
#   bim     -> MAX(pos)     (point position)
#   vcf     -> ##contig length (header mode, compared with =) or MAX(POS, INFO/END) (scan mode)
RAW_CTE=""
compute_raw_cte() {
  case "$ITYPE" in
    parquet)
      # Detect layout from the schema (case-insensitive column name match):
      #   VCF-like : CHROM, POS, REF, ALT  -> chrom=CHROM, coord=POS (point position)
      #   cnvDB    : Chr, Start, End       -> chrom=Chr,   coord=End (1-based inclusive)
      local psrc hdr chr_col coord_col
      psrc=$(parquet_source)
      # hive_partitioning=true: Spark-style writers drop the partition column
      # (e.g. CHROM) from the physical file when partitioning by it, so it
      # only exists via the CHROM=chr1 path segment and must be recovered
      # from there; it is not duplicated with any real column.
      hdr=$(duckdb -noheader -list <<HSQL 2>/dev/null || true
SELECT column_name FROM (DESCRIBE SELECT * FROM read_parquet('$psrc', hive_partitioning=true));
HSQL
)
      [[ -n $hdr ]] || die "parquet: could not read schema of $psrc"
      # has_col NAME -> prints the actual column name matching NAME (case-insensitive), or nothing
      has_col() { printf '%s\n' "$hdr" | awk -v n="$1" 'tolower($0)==tolower(n){print; exit}'; }
      if [[ -n $(has_col CHROM) && -n $(has_col POS) && -n $(has_col REF) && -n $(has_col ALT) ]]; then
        chr_col=$(has_col CHROM); coord_col=$(has_col POS)
      else
        chr_col=$(has_col Chr); [[ -n $chr_col ]] || chr_col=$(has_col CHROM)
        coord_col=$(has_col End)
      fi
      [[ -n $chr_col   ]] || die "parquet: no chromosome column (CHROM/Chr) in [$(printf '%s' "$hdr" | paste -sd, -)]"
      [[ -n $coord_col ]] || die "parquet: no coordinate column (POS/End) in [$(printf '%s' "$hdr" | paste -sd, -)]"
      RAW_CTE=$(cat <<SQL
  SELECT CAST("$chr_col" AS VARCHAR) AS raw_chr, CAST("$coord_col" AS BIGINT) AS coord
  FROM read_parquet('$psrc', hive_partitioning=true)
SQL
)
      ;;
    bim)
      # PLINK .bim: col0=chr col3=bp position, whitespace/tab separated, no header
      RAW_CTE=$(cat <<SQL
  SELECT CAST(column0 AS VARCHAR) AS raw_chr, CAST(column3 AS BIGINT) AS coord
  FROM read_csv('$INPUT', delim='\t', header=false, ignore_errors=true,
                columns={'column0':'VARCHAR','column1':'VARCHAR','column2':'VARCHAR',
                         'column3':'BIGINT','column4':'VARCHAR','column5':'VARCHAR'})
SQL
)
      ;;
    tsv)
      # Delimited text WITH a header. Coordinate columns are matched by name
      # (case-insensitive): chromosome = Chr/chrom/chromosome/#chrom;
      # end = End/stop/pos/position/bp. Delimiter auto-detected by DuckDB.
      # Override the detected names with env vars CHR_COL / END_COL if needed.
      local chr_col="${CHR_COL:-}" end_col="${END_COL:-}"
      # Discover header names, one per line (no delimiter to escape).
      local hdr
      hdr=$(duckdb -noheader -list <<HSQL 2>/dev/null || true
SELECT column_name FROM (DESCRIBE SELECT * FROM read_csv('$INPUT', header=true, sample_size=1));
HSQL
)
      [[ -n $hdr ]] || die "TSV: could not read header of $INPUT (is it delimited with a header row?)"
      if [[ -z $chr_col ]]; then
        chr_col=$(printf '%s\n' "$hdr" \
          | awk 'tolower($0)~/^#?(chr|chrom|chromosome|chr_name)$/{print; exit}')
      fi
      if [[ -z $end_col ]]; then
        end_col=$(printf '%s\n' "$hdr" \
          | awk 'tolower($0)~/^(end|stop|pos|position|bp|bp_position)$/{print; exit}')
      fi
      [[ -n $chr_col ]] || die "TSV: no chromosome column found in header [$(printf '%s' "$hdr" | paste -sd, -)]; set CHR_COL=<name>"
      [[ -n $end_col ]] || die "TSV: no end/pos column found in header [$(printf '%s' "$hdr" | paste -sd, -)]; set END_COL=<name>"
      RAW_CTE=$(cat <<SQL
  SELECT CAST("$chr_col" AS VARCHAR) AS raw_chr, CAST("$end_col" AS BIGINT) AS coord
  FROM read_csv('$INPUT', header=true, ignore_errors=true)
SQL
)
      ;;
    vcf)
      local mode=header
      [[ ${VCF_SCAN:-0} == 1 ]] && mode=scan
      VCF_TMP=$(mktemp "${TMPDIR:-/tmp}/check_genomeref.XXXXXX") || die "cannot create temp file"
      trap 'rm -f -- "$VCF_TMP"' EXIT
      vcf_extract "$mode"
      if [[ $mode == header && ! -s $VCF_TMP ]]; then
        echo "Warning: no ##contig=<ID=...,length=...> lines in header; scanning all records (slow on large gVCFs)" >&2
        mode=scan
        vcf_extract scan
      fi
      [[ -s $VCF_TMP ]] || die "VCF: no ##contig lengths and no records found in $INPUT"
      if [[ $mode == header ]]; then
        CMP_OP='<>' CMP_COL=len_mismatch CMP_WORD=mismatching
      fi
      RAW_CTE=$(cat <<SQL
  SELECT column0 AS raw_chr, column1 AS coord
  FROM read_csv('$VCF_TMP', delim='\t', header=false, quote='',
                columns={'column0':'VARCHAR','column1':'BIGINT'})
SQL
)
      ;;
    bed)
      # BED: col0=chr col1=start col2=end; extra columns (BED4/6/12) are ignored.
      # Skip comment/track/browser lines.
      RAW_CTE=$(cat <<SQL
  SELECT CAST(column0 AS VARCHAR) AS raw_chr, TRY_CAST(column2 AS BIGINT) AS coord
  FROM read_csv('$INPUT', delim='\t', header=false, ignore_errors=true,
                all_varchar=true, null_padding=true, strict_mode=false)
  WHERE column0 NOT LIKE '#%' AND column0 <> 'track' AND column0 <> 'browser'
        AND TRY_CAST(column2 AS BIGINT) IS NOT NULL
SQL
)
      ;;
  esac
}

# Input CTE: produce (chr_display, chr_key, max_end) per chromosome, spliced
# from the $RAW_CTE body cached by compute_raw_cte() (called once, up front).
input_cte() {
  local nk; nk=$(norm_expr 'raw_chr')
  cat <<SQL
raw AS (
$RAW_CTE
),
inp AS (
  SELECT
    any_value(raw_chr) AS chr_display,
    $nk                AS chr_key,
    MAX(coord)         AS max_end
  FROM raw
  GROUP BY $nk
)
SQL
}

# ---- color setup ------------------------------------------------------------
# Honour NO_COLOR and disable when stdout isn't a terminal.
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  C_RESET=$'\e[0m'; C_BOLD=$'\e[1m'; C_DIM=$'\e[2m'
  C_GREEN=$'\e[32m'; C_RED=$'\e[31m'; C_YELLOW=$'\e[33m'; C_CYAN=$'\e[36m'
else
  C_RESET=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_RED=""; C_YELLOW=""; C_CYAN=""
fi

# ---- build and run one query per reference ---------------------------------
# Natural chromosome ordering: 1..22 numeric, then X,Y,MT, then anything else.
ORDER_SQL="CASE WHEN chr_key ~ '^[0-9]+\$' THEN CAST(chr_key AS INTEGER)
                WHEN chr_key='X' THEN 100 WHEN chr_key='Y' THEN 101
                WHEN chr_key='MT' THEN 102 ELSE 200 END, chr_key"

# Detect input columns/layout once, before touching any reference. Any
# validation failure here calls die() directly in the main shell (see
# compute_raw_cte's comment) so the script actually stops instead of
# limping on with a broken CTE. Runs before the banner because it may
# switch the comparison mode (VCF header -> exact length match).
compute_raw_cte

echo "${C_BOLD}Input :${C_RESET} $INPUT  (type: $ITYPE)"
if [[ $CMP_OP == '<>' ]]; then
  echo "Length tested: ##contig length declared in the VCF header vs contig length (must be equal)"
  echo "${C_GREEN}len_mismatch=false${C_RESET} everywhere → header matches that build ; ${C_RED}len_mismatch=true${C_RESET} → different build"
else
  echo "Coordinate tested: max End/pos per chromosome vs contig length"
  echo "${C_GREEN}exceeds=false${C_RESET} everywhere → data fits that build ; ${C_RED}exceeds=true${C_RESET} → data runs past a contig (wrong build)"
fi
echo

nk_fai=$(norm_expr 'fai_contig')

# Accumulators for the final summary (parallel arrays indexed with the loop).
declare -a SUM_LABEL SUM_PATH SUM_EXC SUM_MISS SUM_TOTAL

# Emits the per-reference detail table.
run_table() { # $1 = fai path
  local fai=$1
  duckdb <<SQL
WITH
$(input_cte),
fai AS (
  SELECT CAST(column0 AS VARCHAR) AS fai_contig, CAST(column1 AS BIGINT) AS len,
         $nk_fai AS chr_key
  FROM read_csv('$fai', delim='\t', header=false,
                columns={'column0':'VARCHAR','column1':'BIGINT','column2':'BIGINT',
                         'column3':'BIGINT','column4':'BIGINT'})
)
SELECT
  inp.chr_display                              AS chr,
  inp.max_end                                  AS max_end,
  fai.len                                      AS contig_len,
  (fai.len IS NULL)                            AS not_in_ref,
  CASE WHEN fai.len IS NULL THEN NULL
       ELSE inp.max_end $CMP_OP fai.len END    AS $CMP_COL
FROM inp
LEFT JOIN fai USING (chr_key)
ORDER BY $ORDER_SQL;
SQL
}

# Emits three integers: n_exceeding  n_not_in_ref  n_total  (tab-separated).
run_counts() { # $1 = fai path
  duckdb -noheader -list <<SQL
WITH
$(input_cte),
fai AS (
  SELECT CAST(column0 AS VARCHAR) AS fai_contig, CAST(column1 AS BIGINT) AS len,
         $(norm_expr 'fai_contig') AS chr_key
  FROM read_csv('$1', delim='\t', header=false,
                columns={'column0':'VARCHAR','column1':'BIGINT','column2':'BIGINT',
                         'column3':'BIGINT','column4':'BIGINT'})
),
j AS (
  SELECT fai.len AS len, inp.max_end AS max_end
  FROM inp LEFT JOIN fai USING (chr_key)
)
SELECT
  COALESCE(SUM(CASE WHEN len IS NOT NULL AND max_end $CMP_OP len THEN 1 ELSE 0 END),0),
  COALESCE(SUM(CASE WHEN len IS NULL THEN 1 ELSE 0 END),0),
  COUNT(*)
FROM j;
SQL
}

i=0
for fai in "${FAIS[@]}"; do
  label=$(ref_label "$fai")

  # counts drive the verdict color of the header and the summary line
  IFS='|' read -r n_exc n_miss n_tot < <(run_counts "$fai")
  n_exc=${n_exc:-0}; n_miss=${n_miss:-0}; n_tot=${n_tot:-0}

  if [[ $n_exc -eq 0 && $n_miss -eq 0 ]]; then
    hdr_color=$C_GREEN
  elif [[ $n_exc -eq 0 ]]; then
    hdr_color=$C_YELLOW   # fits, but some contigs weren't found
  else
    hdr_color=$C_RED      # something exceeds → not this build
  fi

  echo "${hdr_color}${C_BOLD}=== Reference: $label ===${C_RESET}"
  echo "${C_DIM}$fai${C_RESET}"
  run_table "$fai"
  echo

  SUM_LABEL[i]=$label; SUM_PATH[i]=$fai
  SUM_EXC[i]=$n_exc; SUM_MISS[i]=$n_miss; SUM_TOTAL[i]=$n_tot
  ((i++)) || true
done

# ---- final summary ----------------------------------------------------------
echo "${C_BOLD}────────────────────────── SUMMARY ──────────────────────────${C_RESET}"
best_idx=-1
for ((k=0; k<i; k++)); do
  exc=${SUM_EXC[k]} miss=${SUM_MISS[k]} tot=${SUM_TOTAL[k]}
  if [[ $exc -eq 0 && $miss -eq 0 ]]; then
    tag="${C_GREEN}✓ MATCH${C_RESET}     "
    [[ $best_idx -lt 0 ]] && best_idx=$k
  elif [[ $exc -eq 0 ]]; then
    tag="${C_YELLOW}~ partial${C_RESET}   "
    [[ $best_idx -lt 0 ]] && best_idx=$k
  else
    tag="${C_RED}✗ excluded${C_RESET}  "
  fi
  # short reference name for readability
  printf '  %b  %-28s  %s\n' "$tag" "${SUM_LABEL[k]} [$(basename "${SUM_PATH[k]}")]" \
    "$(printf "%s $CMP_WORD, %s not-in-ref, of %s contigs" \
        "$([[ $exc -gt 0 ]] && printf '%b%s%b' "$C_RED" "$exc" "$C_RESET" || printf '%s' "$exc")" \
        "$([[ $miss -gt 0 ]] && printf '%b%s%b' "$C_YELLOW" "$miss" "$C_RESET" || printf '%s' "$miss")" \
        "$tot")"
done
echo

n_match=0
for ((k=0; k<i; k++)); do
  [[ ${SUM_EXC[k]} -eq 0 && ${SUM_MISS[k]} -eq 0 ]] && ((n_match++)) || true
done

if [[ $best_idx -ge 0 && $n_match -eq 1 && ${SUM_EXC[best_idx]} -eq 0 && ${SUM_MISS[best_idx]} -eq 0 ]]; then
  echo "${C_GREEN}${C_BOLD}➜ Best match: ${SUM_LABEL[best_idx]} [$(basename "${SUM_PATH[best_idx]}")]${C_RESET}"
  echo "  ${C_DIM}All coordinates fit within this reference and every contig was found.${C_RESET}"
elif [[ $n_match -gt 1 ]]; then
  echo "${C_YELLOW}${C_BOLD}➜ Ambiguous: $n_match references contain all coordinates.${C_RESET}"
  echo "  ${C_DIM}The input's max coordinates don't reach far enough to discriminate between them.${C_RESET}"
elif [[ $best_idx -ge 0 ]]; then
  echo "${C_YELLOW}${C_BOLD}➜ Closest: ${SUM_LABEL[best_idx]} [$(basename "${SUM_PATH[best_idx]}")]${C_RESET} (fits, but some contigs were not found)"
else
  echo "${C_RED}${C_BOLD}➜ No reference contains all coordinates.${C_RESET}"
  echo "  ${C_DIM}Every candidate has at least one contig where the data exceeds its length — check naming or build.${C_RESET}"
fi
